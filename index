    function salvarProcesso() {
      const id = document.getElementById('proc-id').value;
      const cnj = document.getElementById('proc-cnj').value.trim();
      const clienteId = document.getElementById('proc-cliente').value;

      if (!cnj || !clienteId) {
        alert('Por favor, preencha o Número CNJ e selecione o Cliente.');
        return;
      }

      const polo = document.getElementById('proc-polo').value;
      const parteContraria = document.getElementById('proc-parte-contraria').value.trim();
      const tipoAcao = document.getElementById('proc-tipo-acao').value.trim();
      const tribunal = document.getElementById('proc-tribunal').value;
      const comarca = document.getElementById('proc-comarca').value.trim();
      const vara = document.getElementById('proc-vara').value.trim();
      const fase = document.getElementById('proc-fase').value;
      const status = document.getElementById('proc-status').value;
      const valorCausa = document.getElementById('proc-valor').value.trim();
      const advogado = document.getElementById('proc-advogado').value.trim();
      const obs = document.getElementById('proc-obs').value.trim();

      if (id) {
        // Atualização
        const idx = db.processos.findIndex(p => p.id === id);
        if (idx !== -1) {
          db.processos[idx] = {
            ...db.processos[idx],
            numeroCNJ: cnj,
            clienteId,
            polo,
            parteContraria,
            tipoAcao,
            tribunal,
            comarca,
            vara,
            fase,
            status,
            valorCausa,
            advogado,
            obs
          };
        }
      } else {
        // Novo
        const novoProc = {
          id: 'proc_' + Date.now(),
          numeroCNJ: cnj,
          clienteId,
          polo,
          parteContraria,
          tipoAcao,
          tribunal,
          comarca,
          vara,
          fase,
          status,
          valorCausa,
          advogado,
          obs,
          despesas: [],
          honorariosLancamentos: [],
          destaques: [],
          dataCadastro: new Date().toISOString().split('T')[0],
          dataArquivamento: null
        };
        db.processos.push(novoProc);
      }

      salvarDados();
      fecharModal('modal-processo');
      renderTabelaProcessos();
      renderTabelaArquivados();
      atualizarDashboard();
    }

    function arquivarProcesso(id) {
