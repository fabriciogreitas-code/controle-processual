    function formatarDataBR(isoStr) {
      if (!isoStr) return '—';
      const partes = isoStr.split('-');
      if (partes.length !== 3) return isoStr;
      return `${partes[2]}/${partes[1]}/${partes[0]}`;
    }

    function formatarMoeda(valor) {
      if (!valor && valor !== 0) return 'R$ 0,00';
      let num = 0;
      if (typeof valor === 'number') {
        num = valor;
      } else {
        const limpo = String(valor).replace(/\./g, '').replace(',', '.').replace(/[^0-9.-]/g, '');
        num = parseFloat(limpo) || 0;
      }
      return 'R$ ' + num.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function aplicarMascaraMoeda(input) {
      input.addEventListener('input', (e) => {
        let v = e.target.value.replace(/\D/g, '');
        if (!v) {
          e.target.value = '';
          return;
        }
        v = (parseInt(v, 10) / 100).toFixed(2);
        const partes = v.split('.');
        const inteiro = partes[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.');
        e.target.value = inteiro + ',' + partes[1];
      });
    }

    function aplicarMascaraCNJ(input) {
      input.addEventListener('input', (e) => {
        let v = e.target.value.replace(/\D/g, '');
        if (v.length > 20) v = v.substring(0, 20);
        // 0000000-00.0000.0.00.0000
        let r = '';
        if (v.length > 0) r += v.substring(0, Math.min(v.length, 7));
        if (v.length > 7) r += '-' + v.substring(7, Math.min(v.length, 9));
        if (v.length > 9) r += '.' + v.substring(9, Math.min(v.length, 13));
        if (v.length > 13) r += '.' + v.substring(13, Math.min(v.length, 14));
        if (v.length > 14) r += '.' + v.substring(14, Math.min(v.length, 16));
        if (v.length > 16) r += '.' + v.substring(16, 20);
        e.target.value = r;
      });
    }

    function aplicarMascaraCpfCnpj(input) {
      input.addEventListener('input', (e) => {
        let v = e.target.value.replace(/\D/g, '');
        if (v.length <= 11) {
          // CPF: 000.000.000-00
          v = v.substring(0, 11);
          let r = '';
          if (v.length > 0) r += v.substring(0, Math.min(v.length, 3));
          if (v.length > 3) r += '.' + v.substring(3, Math.min(v.length, 6));
          if (v.length > 6) r += '.' + v.substring(6, Math.min(v.length, 9));
          if (v.length > 9) r += '-' + v.substring(9, 11);
          e.target.value = r;
        } else {
          // CNPJ: 00.000.000/0000-00
          v = v.substring(0, 14);
          let r = '';
          if (v.length > 0) r += v.substring(0, Math.min(v.length, 2));
          if (v.length > 2) r += '.' + v.substring(2, Math.min(v.length, 5));
          if (v.length > 5) r += '.' + v.substring(5, Math.min(v.length, 8));
          if (v.length > 8) r += '/' + v.substring(8, Math.min(v.length, 12));
          if (v.length > 12) r += '-' + v.substring(12, 14);
          e.target.value = r;
        }
      });
    }

    function aplicarMascaraTelefone(input) {
      input.addEventListener('input', (e) => {
        let v = e.target.value.replace(/\D/g, '').substring(0, 11);
        let r = '';
        if (v.length > 0) r += '(' + v.substring(0, Math.min(v.length, 2));
        if (v.length >= 2) r += ') ';
        if (v.length > 2 && v.length <= 6) r += v.substring(2);
        if (v.length > 6 && v.length <= 10) r += v.substring(2, 6) + '-' + v.substring(6);
        if (v.length === 11) r += v.substring(2, 7) + '-' + v.substring(7);
        e.target.value = r;
      });
    }

    /* ==========================================================================
       CÁLCULO DE PRAZOS (DIAS ÚTEIS COM FERIADOS DO RJ)
       ========================================================================== */

    function ehDiaUtilRJ(data) {
      const diaSemana = data.getDay(); // 0 = Dom, 6 = Sab
      if (diaSemana === 0 || diaSemana === 6) return false;
      const iso = data.toISOString().split('T')[0];
      if (FERIADOS_RJ.has(iso)) return false;
      return true;
    }

    function calcularVencimento(dataInicioIso, dias, multiplicador, regime, vencimentoManual) {
      if (regime === 'corridos' && vencimentoManual) {
        return vencimentoManual;
      }
      if (!dataInicioIso) return '';

      const totalDias = Math.max(1, parseInt(dias, 10) || 1) * (parseInt(multiplicador, 10) || 1);
      const partes = dataInicioIso.split('-');
      let d = new Date(parseInt(partes[0], 10), parseInt(partes[1], 10) - 1, parseInt(partes[2], 10));

      if (regime === 'corridos') {
        d.setDate(d.getDate() + totalDias);
        const y = d.getFullYear();
        const m = String(d.getMonth() + 1).padStart(2, '0');
        const dia = String(d.getDate()).padStart(2, '0');
        return `${y}-${m}-${dia}`;
      }

      // Regime dias úteis: começa a contar no primeiro dia útil seguinte ao início
      let contados = 0;
      while (contados < totalDias) {
        d.setDate(d.getDate() + 1);
        if (ehDiaUtilRJ(d)) {
          contados++;
        }
      }

      const y = d.getFullYear();
      const m = String(d.getMonth() + 1).padStart(2, '0');
      const dia = String(d.getDate()).padStart(2, '0');
      return `${y}-${m}-${dia}`;
    }

    function diferencaDiasAteHoje(isoVencimento) {
      if (!isoVencimento) return null;
      const hoje = new Date();
      hoje.setHours(0, 0, 0, 0);

      const partes = isoVencimento.split('-');
      const venc = new Date(parseInt(partes[0], 10), parseInt(partes[1], 10) - 1, parseInt(partes[2], 10));
      venc.setHours(0, 0, 0, 0);

      const diffTime = venc.getTime() - hoje.getTime();
      return Math.round(diffTime / (1000 * 60 * 60 * 24));
    }

    /* ==========================================================================
       RELÓGIO AO VIVO
