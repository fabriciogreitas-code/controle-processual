        const regimeDesc = pz.regime === 'uteis'
          ? `Úteis (${pz.dias * (pz.multiplicador || 1)}d)`
          : `Corridos (${pz.dias * (pz.multiplicador || 1)}d)`;

        // Dias restantes
        let badgeDias = `<span class="badge-ff" style="background:#F1F5F9; color:#64748B;">—</span>`;
        if (pz.status === 'Pendente') {
          const diff = diferencaDiasAteHoje(pz.vencimento);
          if (diff !== null) {
            if (diff < 0) {
              badgeDias = `<span class="badge-ff badge-overdue">${Math.abs(diff)}d vencido</span>`;
            } else if (diff <= 3) {
              badgeDias = `<span class="badge-ff badge-urgent">${diff}d restantes</span>`;
            } else if (diff <= 7) {
              badgeDias = `<span class="badge-ff badge-soon">${diff}d restantes</span>`;
            } else {
              badgeDias = `<span class="badge-ff badge-ok">${diff}d restantes</span>`;
            }
          }
        }

        // Status badge
        let statusBadge = '';
        if (pz.status === 'Pendente') {
          statusBadge = `<span class="badge-ff badge-pendente">Pendente</span>`;
        } else if (pz.status === 'Concluído') {
          statusBadge = `<span class="badge-ff badge-concluido">Concluído</span>`;
        } else {
          statusBadge = `<span class="badge-ff badge-cancelado">Cancelado</span>`;
        }

        return `
          <tr>
            <td>
              ${proc ? `<a class="table-link" onclick="abrirFichaProcesso('${proc.id}')">${cnj}</a>` : cnj}
            </td>
            <td><strong>${escapeHtml(pz.motivo)}</strong></td>
            <td><span style="font-size:0.8rem; background:#F8FAFC; padding:2px 8px; border-radius:4px; border:1px solid #E2E8F0;">${regimeDesc}</span></td>
            <td>${formatarDataBR(pz.inicio)}</td>
            <td><strong>${formatarDataBR(pz.vencimento)}</strong></td>
            <td>${badgeDias}</td>
            <td>${statusBadge}</td>
            <td style="text-align: right;">
              <div class="action-group" style="justify-content: flex-end;">
                <button class="btn-ff btn-ff-outline btn-ff-sm" onclick="abrirModalEditarPrazo('${pz.id}')">Editar</button>
                <button class="btn-ff btn-ff-danger btn-ff-sm" onclick="excluirPrazo('${pz.id}')">Excluir</button>
              </div>
            </td>
          </tr>
        `;
      }).join('');
    }

