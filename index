    function salvarPrazo() {
      const id = document.getElementById('prazo-id').value;
      const processoId = document.getElementById('prazo-processo').value;
      const motivo = document.getElementById('prazo-motivo').value.trim();
      const regime = document.getElementById('prazo-regime').value;
      const dias = parseInt(document.getElementById('prazo-dias').value, 10) || 15;
      const multiplicador = parseInt(document.getElementById('prazo-multiplicador').value, 10) || 1;
      const inicio = document.getElementById('prazo-inicio').value;
      const vencimentoManual = document.getElementById('prazo-vencimento-manual').value;
      const status = document.getElementById('prazo-status').value;

      if (!processoId || !motivo || !inicio) {
        alert('Por favor, informe o Processo, o Motivo/Peça e a Data de Início.');
        return;
      }

      const vencimento = calcularVencimento(inicio, dias, multiplicador, regime, vencimentoManual);

      if (id) {
        const idx = db.prazos.findIndex(p => p.id === id);
        if (idx !== -1) {
          db.prazos[idx] = {
            ...db.prazos[idx],
            processoId,
            motivo,
            regime,
            dias,
            multiplicador,
            inicio,
            vencimento,
            vencimentoManual,
            status
          };
        }
      } else {
        db.prazos.push({
          id: 'prz_' + Date.now(),
          processoId,
          motivo,
          regime,
          dias,
          multiplicador,
          inicio,
          vencimento,
          vencimentoManual,
          status
        });
      }

      salvarDados();
      fecharModal('modal-prazo');
      renderTabelaPrazos();
      atualizarDashboard();
    }

