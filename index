    function abrirFichaProcesso(procId) {
      const proc = db.processos.find(p => p.id === procId);
      if (!proc) return;

      const cliNome = getClienteNome(proc.clienteId);

      document.getElementById('ficha-cnj-val').textContent = proc.numeroCNJ;
      document.getElementById('ficha-partes-val').textContent = `${cliNome} × ${proc.parteContraria || 'Não informada'}`;

      const badgesContainer = document.getElementById('ficha-badges-container');
      const statusBadge = proc.status === 'Ativo' ? 'badge-ativo' : (proc.status === 'Suspenso' ? 'badge-suspenso' : 'badge-arquivado');
      badgesContainer.innerHTML = `
        <span class="badge-ff ${statusBadge}">Status: ${proc.status}</span>
        <span class="badge-ff" style="background:#F1F5F9; color:#1E293B;">Tribunal: ${proc.tribunal || 'TJRJ'}</span>
        <span class="badge-ff" style="background:#F1F5F9; color:#1E293B;">Ação: ${escapeHtml(proc.tipoAcao || 'Geral')}</span>
      `;

      document.getElementById('ficha-comarca').textContent = proc.comarca || '—';
      document.getElementById('ficha-vara').textContent = proc.vara || '—';
      document.getElementById('ficha-fase').textContent = proc.fase || '—';
      document.getElementById('ficha-polo').textContent = proc.polo || '—';
      document.getElementById('ficha-advogado').textContent = proc.advogado || '—';
      document.getElementById('ficha-valor').textContent = formatarMoeda(proc.valorCausa);
      document.getElementById('ficha-obs').textContent = proc.obs || 'Nenhuma observação registrada.';

      // Andamentos do processo (mais recente primeiro)
      const andamentosProc = (db.andamentos || [])
        .filter(a => a.processoId === proc.id)
        .sort((a, b) => (b.data || '').localeCompare(a.data || ''));

      document.getElementById('ficha-andamentos-title').textContent = `Andamentos (${andamentosProc.length})`;
      const andamentosList = document.getElementById('ficha-andamentos-list');

      if (andamentosProc.length === 0) {
        andamentosList.innerHTML = `<div style="font-size:0.875rem; color:var(--text-muted); padding:10px 0;">Nenhum andamento cadastrado para este processo.</div>`;
      } else {
        andamentosList.innerHTML = andamentosProc.map(a => `
          <div style="border-left: 3px solid var(--accent-secondary); padding-left: 12px; margin-bottom: 12px;">
            <div style="font-size:0.75rem; color:var(--text-muted); font-weight:600;">${formatarDataBR(a.data)} · ${escapeHtml(a.tipo || 'Andamento')}</div>
            <div style="font-size:0.875rem; margin-top:2px;">${escapeHtml(a.descricao || '')}</div>
          </div>
        `).join('');
      }

      // Prazos do processo
      const prazosProc = (db.prazos || [])
        .filter(pz => pz.processoId === proc.id)
        .sort((a, b) => (a.vencimento || '').localeCompare(b.vencimento || ''));

      document.getElementById('ficha-prazos-title').textContent = `Prazos (${prazosProc.length})`;
      const prazosList = document.getElementById('ficha-prazos-list');

      if (prazosProc.length === 0) {
        prazosList.innerHTML = `<div style="font-size:0.875rem; color:var(--text-muted); padding:10px 0;">Nenhum prazo registrado.</div>`;
      } else {
        prazosList.innerHTML = prazosProc.map(pz => {
          let badgeStatus = `<span class="badge-ff badge-pendente">Pendente</span>`;
          if (pz.status === 'Concluído') badgeStatus = `<span class="badge-ff badge-concluido">Concluído</span>`;
          if (pz.status === 'Cancelado') badgeStatus = `<span class="badge-ff badge-cancelado">Cancelado</span>`;

          return `
            <div style="display:flex; justify-content:space-between; align-items:center; padding:8px 0; border-bottom:1px solid #F1F5F9;">
              <div>
                <strong style="font-size:0.875rem;">${escapeHtml(pz.motivo)}</strong>
                <div style="font-size:0.75rem; color:var(--text-muted);">Vencimento: ${formatarDataBR(pz.vencimento)}</div>
              </div>
              <div>${badgeStatus}</div>
            </div>
          `;
        }).join('');
      }

      abrirModal('modal-ficha');
    }

